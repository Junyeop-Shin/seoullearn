# 이 파일을 .env로 복사한 뒤 키를 넣는다. .env는 Git에 올리지 않는다.

# --- 답변 생성 LLM ---
# 제공사·모델을 바꿀 때는 이 두 줄만 바꾼다.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=여기에_Gemini_API_키

# OpenAI로 바꿀 때
# LLM_PROVIDER=openai
# LLM_MODEL=사용할_OpenAI_모델명
# OPENAI_API_KEY=...

# --- 평가 채점 LLM (개선 전후 비교 동안 고정) ---
JUDGE_PROVIDER=google_genai
JUDGE_MODEL=gemini-3.8-flash

# --- 임베딩 (바꾸면 재색인. 로컬 모델로 고정 권장) ---
# 기본: 한국어 검색용 경량 모델 (1.2억 파라미터, 약 0.5GB)
# 비교 대상(대형, 약 5.6~5.7억 파라미터): BAAI/bge-m3, intfloat/multilingual-e5-large-instruct. 평가할 때 --embedding-model로 바꿔 돌린다.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=dragonkue/multilingual-e5-small-ko-v2

# --- 검색·요청 한도 ---
TOP_K=5
# 무료 등급 한도에 맞춰 분당 요청 수를 낮춘다. 429가 자주 나면 더 낮춘다.
LLM_RPM=8

# --- API 서버가 쓸 설정 ---
QA_PIPELINE=md_hybrid_glossary
QA_CORPUS=v2
