# 이 파일을 .env로 복사한 뒤 키를 넣는다. .env는 Git에 올리지 않는다.

# --- 답변 생성 LLM ---
# 제공사·모델을 바꿀 때는 이 두 줄만 바꾼다.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_API_KEY=여기에_OpenAI_API_키

# Gemini로 바꿀 때 (무료 등급은 모델당 하루 20회 한도라 평가 전체를 돌리기 어렵다)
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-3.6-flash
# GOOGLE_API_KEY=...

# --- 평가 채점 LLM (개선 전후 비교 동안 고정) ---
# 1-A-4 기준 측정을 이 모델로 했다. 바꾸면 그 전 점수와 비교할 수 없다.
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5.4-mini-2026-03-17

# --- 임베딩 (바꾸면 재색인. 로컬 모델로 고정 권장) ---
# 기본: 한국어 검색용 경량 모델 (1.2억 파라미터, 약 0.5GB)
# 비교 대상(대형, 약 5.6~5.7억 파라미터): BAAI/bge-m3, intfloat/multilingual-e5-large-instruct. 평가할 때 --embedding-model로 바꿔 돌린다.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=dragonkue/multilingual-e5-small-ko-v2

# --- 리랭커 (md_hybrid_glossary_rerank 설정에서만 쓴다) ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_POOL=20

# --- 벡터 색인 위치 ---
# pgvector = PostgreSQL(db 서비스), file = .cache/index_*.npy. 평가와 테스트는 항상 file 방식으로 돈다.
VECTOR_BACKEND=pgvector
# 개발용 DB 비밀번호. 배포할 때는 반드시 바꾼다.
POSTGRES_PASSWORD=seoullearn_dev

# --- 검색·요청 한도 ---
TOP_K=5
# 분당 요청 수 상한. 429가 자주 나면 낮춘다 (Gemini 무료 등급은 8 이하).
LLM_RPM=30

# --- API 서버가 쓸 설정 ---
QA_PIPELINE=md_hybrid_glossary
QA_CORPUS=v2
